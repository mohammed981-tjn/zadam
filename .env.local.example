NEXT_PUBLIC_SUPABASE_URL=https://ngcbgagtjbhbbscvsfwt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vSwmv9XGet_Jl2nalAHdRA_awyKuM19

# Secret — required for signing up by phone number.
#
# A phone account is created already confirmed, because the address the number is
# folded into cannot receive a confirmation link, and only the admin API can do
# that. Copy it from Supabase → Project Settings → API → service_role. It
# bypasses row-level security, so it must never carry a NEXT_PUBLIC_ prefix and
# never be committed with a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Secret — the semantic half of retrieval, from jina.ai/embeddings.
#
# Free tier is a million tokens a month, which at this base's size is more than
# a year of questions. Preferred over Gemini for embeddings because it is
# reachable from more places: an account-level block on the Google project once
# took the whole feature out, and no new key could fix it.
#
# Without any embedding provider the assistant still answers — retrieval falls
# back to lexical ranking, which the dialect layer in retrieval.ts covers a good
# deal of — but questions phrased in vocabulary the base does not use find less.
#
# Changing provider means re-running scripts/backfill-embeddings.ts: vectors
# from different models are not comparable, and match_knowledge_entries filters
# to the current model, so unconverted rows are invisible rather than wrong.
JINA_API_KEY=

# Secret — get your own free key at aistudio.google.com, never commit a real value here.
#
# Heads the model chain, and is the fallback embedding provider when JINA_API_KEY
# is unset. Note that Gemini API access is granted per Google Cloud project and
# can be denied at that level — a 403 no key can fix — which is why nothing here
# depends on it alone.
GEMINI_API_KEY=

# Optional but strongly recommended — the standby pool at openrouter.ai/keys.
#
# A free tier is not a dependable thing to hang a feature on: quotas exhaust
# mid-afternoon and free models get retired without notice. With this set, a
# Gemini quota wall costs a second of latency instead of the answer, because the
# chain moves on to OpenRouter's free models.
OPENROUTER_API_KEY=

# Optional. Comma-separated model ids overriding the built-in free pool in
# src/lib/engines.ts. Which models carry a `:free` tag changes on OpenRouter's
# schedule, so if the standby ever stops answering, check the current list at
# openrouter.ai/models?max_price=0 and set it here — no code change needed.
OPENROUTER_MODELS=

# Optional. When set, /api/health refuses any request without this bearer token,
# so only the scheduled jobs can run the daily check. Vercel Cron sends it
# automatically; for the GitHub Actions workflow add the same value as a repo
# secret alongside HEALTH_URL.
CRON_SECRET=
